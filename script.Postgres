create schema hms;


CREATE TABLE IF NOT EXISTS hms.Hotel (
    IdHotel SERIAL PRIMARY KEY,
    Name VARCHAR(500),
    City VARCHAR(500)
);
COMMENT ON TABLE hms.Hotel IS 'Table to store Hotel information';
COMMENT ON COLUMN hms.Hotel.IdHotel IS 'Unique identifier for each Hotel';
COMMENT ON COLUMN hms.Hotel.Name IS 'Name of Hotel';
COMMENT ON COLUMN hms.Hotel.City IS 'In which city located Hotel';

--------------------------------------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS hms.Room (
    IDRoom SERIAL PRIMARY KEY,
    IdHotel INT REFERENCES hms.Hotel(IdHotel),
    room_number INT NOT NULL,
    type VARCHAR(50),
    cost NUMERIC(10,2),
    status VARCHAR(20) NOT NULL CHECK (status IN ('free', 'occupied'))
);
COMMENT ON TABLE hms.Room IS 'Table to store room information';
COMMENT ON COLUMN hms.Room.IDRoom IS 'Unique identifier for each room';
COMMENT ON COLUMN hms.Room.type IS 'Type of the room (Luxe, Standart)';
COMMENT ON COLUMN hms.Room.cost IS 'Cost of the room';
COMMENT ON COLUMN hms.Room.status IS 'Status of the room (Free, Occupied)';

-------------------------------------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS hms.Guests (
    IDGuest SERIAL PRIMARY KEY,
    first_name VARCHAR(200) NOT NULL,
    last_name VARCHAR(200) NOT NULL,
    email VARCHAR(200) NOT NULL UNIQUE,
    phone VARCHAR(20) NOT NULL
);
COMMENT ON TABLE hms.Guests IS 'Table to store guests information';
COMMENT ON COLUMN hms.Guests.IDGuest IS 'Unique identifier for each guests';
COMMENT ON COLUMN hms.Guests.first_name IS 'First name of the guest';
COMMENT ON COLUMN hms.Guests.last_name IS 'Last name of the guest';
COMMENT ON COLUMN hms.Guests.email IS 'Email address of the guest';
COMMENT ON COLUMN hms.Guests.phone IS 'Phone number of the guest';

--------------------------------------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS hms.Booking (
    IDBooking SERIAL PRIMARY KEY,
    IDRoom INT REFERENCES hms.Room(IDRoom),
    IDGuest INT REFERENCES hms.Guests(IDGuest),
    arrival_date date not null,
    departure_date  date not null,
    total_sum NUMERIC(12,2)
);
COMMENT ON TABLE hms.Booking IS 'Table to store Booking information';
COMMENT ON COLUMN hms.Booking.IDBooking IS 'Unique identifier for each Booking';
COMMENT ON COLUMN hms.Booking.IDRoom IS 'Foreign key';
COMMENT ON COLUMN hms.Booking.arrival_date IS 'Arrival date of the Booking';
COMMENT ON COLUMN hms.Booking.departure_date IS 'Departure date of the Booking';
COMMENT ON COLUMN hms.Booking.total_sum IS 'Total Sum of the Booking';

-----------------------------------------------------------------------------------------------------
create table hms.Review
(
    ReviewID serial primary key,
    IDGuest  int,
    IDHotel  int REFERENCES hms.Hotel(IdHotel),
    Description varchar(100),
    Score int CHECK ( Score>=1 AND Score<=5 ),
    foreign key(IDGuest) references  hms.Guests(IDGuest),
    foreign key(IDHotel) references   hms.Hotel(IDHotel)
);
COMMENT ON TABLE hms.Review IS 'Table to store Review information';
COMMENT ON COLUMN hms.Review.ReviewID IS 'Unique identifier for each Review';
COMMENT ON COLUMN hms.Review.IDGuest IS 'Foreign key';
COMMENT ON COLUMN hms.Review.IDHotel IS 'Foreign key';
COMMENT ON COLUMN hms.Review.Description IS 'Description of the feedback';
COMMENT ON COLUMN hms.Review.Score IS 'Score of the hotel';

------------------------------------------------------------------------------------------------------
create table hms.Rate
(
    RateID serial primary key,
    IDGuest  int,
    IDHotel  int,
    foreign key(IDGuest) references   hms.Guests(IDGuest),
    foreign key(IDHotel) references   hms.Hotel(IDHotel)
);
COMMENT ON TABLE hms.Rate IS 'Table to store Rate information';
COMMENT ON COLUMN hms.Rate.RateID IS 'Unique identifier for each Rate';
COMMENT ON COLUMN hms.Rate.IDHotel IS 'Foreign key';

------------------------------------------------------------------------------------------------------
CREATE TABLE hms.Promo_code(
    id INT PRIMARY KEY,
    code VARCHAR(50),
    type VARCHAR(100),
    discount DECIMAL(10,2),
    IDHotel INT REFERENCES hms.Hotel(IdHotel),
    FOREIGN KEY (IDHotel) REFERENCES  hms.Hotel(IDHotel)
);
COMMENT ON TABLE hms.Promo_code IS 'Table to store Promo_code information';
COMMENT ON COLUMN hms.Promo_code.id IS 'Unique identifier for each Promo_code';
COMMENT ON COLUMN hms.Promo_code.code IS 'Code of Promo_code';
COMMENT ON COLUMN hms.Promo_code.type IS 'Type of Promo_code';
COMMENT ON COLUMN hms.Promo_code.discount IS 'Description of the feedback';
COMMENT ON COLUMN hms.Promo_code.IDHotel IS 'Foreign key';

------------------------------------------------------------------------------------------------------
CREATE TABLE hms.loyalty(
    IDLoyalty INT PRIMARY KEY,
    type VARCHAR(100),
    discount DECIMAL(10,2),
    score INT,
    IDGuest INT references hms.Guests(IDGuest)
   -- FOREIGN KEY (IDGuest) REFERENCES  hms.Guests(IDGuest)
);
COMMENT ON TABLE hms.loyalty IS 'Table to store room information';
COMMENT ON COLUMN hms.loyalty.IDLoyalty IS 'Unique identifier for each room';
COMMENT ON COLUMN hms.loyalty.type IS 'Type of loyalty';
COMMENT ON COLUMN hms.loyalty.discount IS 'Discount of loyalty';
COMMENT ON COLUMN hms.loyalty.score IS 'Score of loyalty';
COMMENT ON COLUMN hms.loyalty.IDGuest IS 'Foreign key';

------------------------------------------------------------------------------------------------------
CREATE TABLE hms.sales(
    IDSales INT PRIMARY KEY,
    discount DECIMAL(10,2),
    restaurant_id INT
);
COMMENT ON TABLE hms.sales IS 'Table to store sales information';
COMMENT ON COLUMN hms.sales.IDSales IS 'Unique identifier for each sales';
COMMENT ON COLUMN hms.sales.discount IS  'Discount of sales';
COMMENT ON COLUMN hms.sales.restaurant_id IS 'Foreign key';

------------------------------------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS hms.Services (
    IDService SERIAL PRIMARY KEY,
    name VARCHAR(255) not null,
    cost NUMERIC(10,2) NOT NULL CHECK ( cost > 0)
);

COMMENT ON TABLE hms.Services IS 'Table to store Services schedule';
COMMENT ON COLUMN hms.Services.IDService IS 'Unique identifier for each Services schedule';
COMMENT ON COLUMN hms.Services.name IS 'Name of the Services';
COMMENT ON COLUMN hms.Services.cost IS 'Cost of the Services';

--------------------------------------------------------------------------------------------------------

CREATE TABLE IF NOT EXISTS hms.Booking_Services (
    IDBooking INT REFERENCES hms.Booking(IDBooking),
    IDService INT REFERENCES hms.Services(IDService),
    PRIMARY KEY (IDBooking, IDService)
);








--------------------------------------------------------------------------------------------------------

CREATE INDEX IF NOT EXISTS idx_guest_email ON hms.Guests(email);
CREATE INDEX IF NOT EXISTS idx_booking_dates ON hms.Booking(arrival_date);
CREATE INDEX IF NOT EXISTS idx_room_hotel ON hms.Room(status);
